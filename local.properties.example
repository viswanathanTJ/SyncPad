# This is a template file for local.properties
# Copy this file to local.properties and fill in your values.
# DO NOT commit local.properties to version control!

# Android SDK location (required by Android Studio, usually auto-generated)
# sdk.dir=/path/to/your/android/sdk

# ============================================
# SECRETS CONFIGURATION
# ============================================
# Add your secrets below. These will be exposed via BuildConfig.
# If secrets are missing, the app will still build and run gracefully
# with empty/default values, but certain features may be limited.

# Example API key for sync + app update checks
# SYNC_API_KEY=your_anon_key_here

# Example backend URL for sync + app update checks
# SYNC_BASE_URL=https://your-project.supabase.co

# Service role key for release uploads (used by upload_release.py/create_release.py)
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# Release signing configuration
# KEYSTORE_FILE=/Users/yourname/Documents/viswa2k.jks
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
